      "next": null
    },
    {
      "type": "dialogue", "speaker": "ラヴィオル",
      "sprite": {"character": "raviol", "emotion": "neutral", "position": "center"},
      "text": [
        {"content": "……お使いになりますか？", "style": null}
      ],
      "next": null
    },
    {
      "type": "dialogue", "speaker": "ミシェリア",
      "sprite": {"character": "miche", "emotion": "surprise", "position": "center"},
      "text": [
        {"content": "ええっ？", "style": null}
      ],
      "next": null
    },
    {
      "type": "dialogue", "speaker": "ラヴィオル",
      "sprite": {"character": "raviol", "emotion": "neutral", "position": "center"},
      "text": [
        {"content": "どうぞ。ご遠慮なさらずに。", "style": null}
      ],
      "next": null
    },
    {
      "type": "dialogue", "speaker": "ミシェリア",
      "sprite": {"character": "miche", "emotion": "surprise", "position": "center"},
      "text": [
        {"content": "し、しかし……。", "style": null}
      ],
      "next": null
    },
    {
      "type": "dialogue", "speaker": "ラヴィオル",
      "sprite": {"character": "raviol", "emotion": "neutral", "position": "center"},
      "text": [
        {"content": "……。", "style": null}
      ],
      "next": null
    },
    {
      "type": "dialogue", "speaker": "ミシェリア",
      "sprite": {"character": "miche", "emotion": "surprise", "position": "center"},
      "text": [
        {"content": "チーズなどかけたら美味しいに決まっています……。\nいやでも、そうすると……。", "style": null}
